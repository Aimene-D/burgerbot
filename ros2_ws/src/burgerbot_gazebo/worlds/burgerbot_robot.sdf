<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="burgerbot">
    <pose>0 0 0.065 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>2.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="base_visual">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry><cylinder><radius>0.0825</radius><length>0.09</length></cylinder></geometry>
        <material><ambient>0.2 0.4 0.9 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material>
      </visual>
      <collision name="base_collision">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry><cylinder><radius>0.0825</radius><length>0.09</length></cylinder></geometry>
      </collision>
    </link>

    <link name="left_wheel_link">
      <pose>0 0.12 0 -1.5707963 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.0006</ixx><iyy>0.0006</iyy><izz>0.0006</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      <collision name="collision"><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="right_wheel_link">
      <pose>0 -0.12 0 -1.5707963 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.0006</ixx><iyy>0.0006</iyy><izz>0.0006</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      <collision name="collision"><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="front_caster_link">
      <pose>0.0575 0 -0.0475 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><geometry><sphere><radius>0.0175</radius></sphere></geometry></visual>
      <collision name="collision"><geometry><sphere><radius>0.0175</radius></sphere></geometry><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
    </link>
    <joint name="front_caster_joint" type="fixed"><parent>base_link</parent><child>front_caster_link</child></joint>

    <link name="rear_caster_link">
      <pose>-0.0545 0 -0.0475 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><geometry><sphere><radius>0.0175</radius></sphere></geometry></visual>
      <collision name="collision"><geometry><sphere><radius>0.0175</radius></sphere></geometry><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
    </link>
    <joint name="rear_caster_joint" type="fixed"><parent>base_link</parent><child>rear_caster_link</child></joint>

    <!-- LiDAR LDS-01 avec gpu_lidar -->
    <link name="base_scan">
      <pose>-0.032 0 0.171 0 0 0</pose>
      <inertial><mass>0.114</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.0508</radius><length>0.055</length></cylinder></geometry>
        <material><ambient>1.0 0.4 0.0 1</ambient><diffuse>1.0 0.4 0.0 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.0508</radius><length>0.055</length></cylinder></geometry>
      </collision>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>3.5</max>
            <resolution>0.015</resolution>
          </range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
        <topic>/scan</topic>
      </sensor>
    </link>
    <joint name="scan_joint" type="fixed"><parent>base_link</parent><child>base_scan</child></joint>

    <!-- Plugin Diff Drive -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.24</wheel_separation>
      <wheel_radius>0.065</wheel_radius>
      <odom_publish_frequency>10</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

  </model>
</sdf>
